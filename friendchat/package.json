{
  "name": "friendchat",
  "version": "1.0.0",
  "description": "Private friend chat application",
  "scripts": {
    "build": "cd client && npm install --legacy-peer-deps && npm run build",
    "start": "node server/index.js",
    "install:server": "cd server && npm install --production",
    "dev": "concurrently \"node server/index.js\" \"cd client && npm start\""
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
